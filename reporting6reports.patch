+                <td class="r" th:text="${fmt.days(item.daysSinceLastMovement())}">—</td>
+            </tr>
+        </tbody>
+    </table>
+
+</div>
+
+<div class="footer">
+    Elle A Osé — Bokati Cowork &nbsp;·&nbsp; Valorisation stock &nbsp;·&nbsp; Généré le <span th:text="${generatedAt}">—</span> &nbsp;·&nbsp; Document confidentiel
+</div>
+</body>
+</html>
