+                    <div class="kpi-label">Emplacements</div>
+                    <div class="kpi-value" th:text="${fmt.num(report.totalLocations())}">—</div>
+                </div>
+            </td>
+        </tr>
+    </table>
+
+    <!-- PAR CATÉGORIE -->
+    <table class="section-tbl" th:if="${report.byCategory() != null and !report.byCategory().isEmpty()}"><tr>
+        <td style="width:18px;"><span class="sl-bar"></span></td>
+        <td class="sl-text">Valorisation par catégorie</td>
+        <td><div class="sl-line"></div></td>
+    </tr></table>
+
+    <table class="data-tbl" th:if="${report.byCategory() != null and !report.byCategory().isEmpty()}">
