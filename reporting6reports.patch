+.data-tbl th.r { text-align: right; }
+.data-tbl td { font-size: 9px; color: #1a0a2e; padding: 6px 9px; border-bottom: 1px solid #d8d0e8; vertical-align: top; }
+.data-tbl td.r { text-align: right; font-weight: 700; }
+.data-tbl tr.even td { background: #f0eaff; }
