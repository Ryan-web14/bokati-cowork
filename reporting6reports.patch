+            <th>Catégorie</th>
+            <th class="r">Articles</th>
+            <th class="r">Quantité</th>
+            <th class="r">Valeur</th>
+            <th class="r">Part (%)</th>
+        </tr></thead>
+        <tbody>
+            <tr th:each="cat, stat : ${report.byCategory()}" th:class="${stat.even} ? 'even' : ''">
+                <td th:text="${cat.categoryName() ?: cat.categoryCode()}">—</td>
+                <td class="r" th:text="${fmt.num(cat.itemCount())}">—</td>
+                <td class="r" th:text="${cat.totalQuantity().toPlainString()}">—</td>
+                <td class="r" th:text="${fmt.money(cat.totalValue())}">—</td>
+                <td class="r" th:text="${fmt.pct(cat.percentage())}">—</td>
+            </tr>
