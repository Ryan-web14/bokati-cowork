+.sl-line { height: 1px; background: #d8d0e8; }
+
+.kpi-tbl { width: 100%; border-collapse: collapse; }
+.kpi-tbl td { border: none; padding: 0 5px 0 0; vertical-align: top; }
+.kpi-tbl td:last-child { padding-right: 0; }
+.kpi-card { border: 1px solid #d8d0e8; border-radius: 3px; padding: 8px 10px; }
+.kpi-label { font-size: 6.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #5c4f6e; margin-bottom: 3px; }
+.kpi-value { font-size: 13px; font-weight: 700; color: #1a0a2e; }
