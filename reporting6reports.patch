+            <th>Type</th>
+            <th class="r">Articles</th>
+            <th class="r">Quantité</th>
+            <th class="r">Valeur</th>
+            <th class="r">Part (%)</th>
+        </tr></thead>
+        <tbody>
+            <tr th:each="loc, stat : ${report.byLocation()}" th:class="${stat.even} ? 'even' : ''">
+                <td th:text="${loc.locationName() ?: loc.locationCode()}">—</td>
+                <td th:text="${loc.locationType()}">—</td>
+                <td class="r" th:text="${fmt.num(loc.itemCount())}">—</td>
+                <td class="r" th:text="${loc.totalQuantity().toPlainString()}">—</td>
+                <td class="r" th:text="${fmt.money(loc.totalValue())}">—</td>
+                <td class="r" th:text="${fmt.pct(loc.percentage())}">—</td>
+            </tr>
+        </tbody>
+    </table>
+
+    <!-- STOCK FAIBLE -->
+    <table class="section-tbl" th:if="${report.lowStockItems() != null and !report.lowStockItems().isEmpty()}"><tr>
+        <td style="width:18px;"><span class="sl-bar"></span></td>
+        <td class="sl-text">Articles en stock faible</td>
+        <td><div class="sl-line"></div></td>
+    </tr></table>
+
+    <table class="data-tbl" th:if="${report.lowStockItems() != null and !report.lowStockItems().isEmpty()}">
+        <thead><tr>
+            <th>Code</th>
+            <th>Article</th>
+            <th>Catégorie</th>
+            <th class="r">Qté disponible</th>
+            <th class="r">Seuil réappro.</th>
+            <th class="r">Qté à commander</th>
+        </tr></thead>
+        <tbody>
+            <tr th:each="item, stat : ${report.lowStockItems()}" th:class="${stat.even} ? 'even' : ''">
+                <td th:text="${item.itemCode()}">—</td>
+                <td th:text="${item.itemName()}">—</td>
+                <td th:text="${item.categoryName()}">—</td>
+                <td class="r" th:text="${item.quantityAvailable().toPlainString()}">—</td>
+                <td class="r" th:text="${item.reorderPoint().toPlainString()}">—</td>
+                <td class="r" th:text="${item.reorderQuantity().toPlainString()}">—</td>
+            </tr>
+        </tbody>
+    </table>
+
+    <!-- STOCK MORT -->
+    <table class="section-tbl" th:if="${report.deadStockItems() != null and !report.deadStockItems().isEmpty()}"><tr>
+        <td style="width:18px;"><span class="sl-bar"></span></td>
+        <td class="sl-text">Stock dormant</td>
+        <td><div class="sl-line"></div></td>
+    </tr></table>
+
+    <table class="data-tbl" th:if="${report.deadStockItems() != null and !report.deadStockItems().isEmpty()}">
+        <thead><tr>
+            <th>Code</th>
+            <th>Article</th>
+            <th>Catégorie</th>
+            <th>Emplacement</th>
+            <th class="r">Qté en stock</th>
+            <th class="r">Valeur</th>
+            <th>Dernier mvt</th>
+            <th class="r">Inactif depuis</th>
+        </tr></thead>
+        <tbody>
+            <tr th:each="item, stat : ${report.deadStockItems()}" th:class="${stat.even} ? 'even' : ''">
+                <td th:text="${item.itemCode()}">—</td>
+                <td th:text="${item.itemName()}">—</td>
+                <td th:text="${item.categoryName()}">—</td>
+                <td th:text="${item.locationName()}">—</td>
+                <td class="r" th:text="${item.quantityOnHand().toPlainString()}">—</td>
+                <td class="r" th:text="${fmt.money(item.stockValue())}">—</td>
