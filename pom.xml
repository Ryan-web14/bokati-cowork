				</dependency>
			</dependencies>
		</profile>
		<!-- Build Heroku (la variable STACK n'existe que la) : jar extrait et cache de demarrage AOT,
		     voir tools/heroku/preparer-demarrage.sh. Le jar complet est supprime pour la taille du slug,
		     d'ou l'installation dans le depot local sautee. -->
		<profile>
			<id>heroku</id>
			<activation>
				<property>
					<name>env.STACK</name>
				</property>
			</activation>
			<properties>
				<maven.install.skip>true</maven.install.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.3</version>
						<executions>
							<execution>
								<id>preparer-demarrage</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>sh</executable>
									<arguments>
										<argument>${project.basedir}/tools/heroku/preparer-demarrage.sh</argument>
										<argument>${project.build.directory}</argument>
										<argument>${java.home}/bin/java</argument>
										<argument>${project.build.finalName}.jar</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

